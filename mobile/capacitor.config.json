{
  "appId": "ru.oldgold.personal",
  "appName": "OldGold",
  "webDir": "shell",
  "backgroundColor": "#1a130d",
  "server": {
    "url": "https://xxxlexolasxxx.github.io/OldGold/",
    "cleartext": false,
    "androidScheme": "https",
    "allowNavigation": ["xxxlexolasxxx.github.io"],
    "errorPath": "offline.html"
  },
  "ios": { "contentInset": "never", "backgroundColor": "#1a130d" },
  "android": { "backgroundColor": "#1a130d", "allowMixedContent": false },
  "plugins": {
    "SplashScreen": { "launchShowDuration": 1200, "launchAutoHide": true, "backgroundColor": "#1a130d", "showSpinner": false },
    "SystemBars": { "insetsHandling": "css", "initialViewportFitValueHint": "cover" }
  }
}
